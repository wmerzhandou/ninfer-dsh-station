[Unit]
Description=billion-context proxy (ninfer 压缩层, 8787)
After=network.target codex-model-gateway.service

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=%h
ExecStart=%h/.local/bin/bili start
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
