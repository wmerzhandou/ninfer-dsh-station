+// LOCAL FORK (Linux port) of the independent-handle read path above.
+//
+// Same design, same measured reason: a shared mapping serialises concurrent unbuffered reads;
+// N independent descriptors, each pread()ing its own slice, do not. On Linux the direct-I/O flag
+// is O_DIRECT (counterpart of FILE_FLAG_NO_BUFFERING) and the sequential hint is
+// posix_fadvise(POSIX_FADV_SEQUENTIAL) (counterpart of FILE_FLAG_SEQUENTIAL_SCAN).
+//
+// Linux needs no path widening: paths reach here as UTF-8 bytes and open(2) takes them as-is.
+// widen_utf8_path() is kept as an identity so the mode/call structure below stays identical to
+// the Windows side.
+//
+// The 4K alignment contract is the same on both platforms (O_DIRECT wants offset, length and
+// buffer on the block boundary; our object offsets are only 256-byte aligned), so mode 2 still
+// reads through the same aligned bounce buffer, with the same kChunk / kSector / shift arithmetic.
+//
+// Any failure returns false and the caller falls back to memcpy -- identical to Windows.
+
+int pin_readfile_mode() {
+    static const int mode = [] {
+        const char* value = std::getenv("NINFER_FLASH_NEXT_PIN_READFILE");
+        if (value == nullptr || value[0] == '\0') { return 0; }
+        const long parsed = std::strtol(value, nullptr, 10);
+        return parsed <= 0 ? 0 : (parsed >= 2 ? 2 : 1);
+    }();
+    return mode;
+}
+
+std::string widen_utf8_path(const char* text) {
+    // Identity on Linux: open(2) consumes UTF-8 bytes directly.
+    if (text == nullptr || text[0] == '\0') { return {}; }
+    return std::string(text);
+}
