+#ifndef _WIN32
+// LOCAL FORK (Linux port): the Windows pair above reads IO_COUNTERS.ReadTransferCount, "bytes this
+// process pulled from storage". The Linux equivalent of that exact quantity is the read_bytes field
+// of /proc/self/io (bytes this process caused the block layer to fetch). Same question, same answer,
+// native mechanism -- not a stub. Called once per profiling window, not per token.
+namespace {
+bool linux_proc_read_bytes(std::uint64_t& out) noexcept {
+    std::FILE* f = std::fopen("/proc/self/io", "r");
+    if (f == nullptr) { return false; }
+    bool found = false;
+    char line[256];
+    while (std::fgets(line, sizeof(line), f) != nullptr) {
+        unsigned long long parsed = 0;
+        if (std::sscanf(line, "read_bytes: %llu", &parsed) == 1) {
+            out   = static_cast<std::uint64_t>(parsed);
+            found = true;
+            break;
+        }
+    }
+    std::fclose(f);
+    return found;
+}
+}  // namespace
+#endif
 
